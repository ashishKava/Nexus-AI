{
  "name": "nexus-ai",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\" \"cd services/ai && PYTHONPATH=. ./venv/bin/uvicorn app.main:app --reload --port 8000\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:build": "docker compose -f docker-compose.prod.yml build",
    "docker:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose -f docker-compose.prod.yml down",
    "docker:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}